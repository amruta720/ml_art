# Ollama Configuration (Free Local LLM - No API Key Required!)
# Ollama runs locally on your machine - completely free!
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434

# Model Configuration
STABLE_DIFFUSION_MODEL=stabilityai/stable-diffusion-2-1

# Server Configuration
HOST=0.0.0.0
PORT=8000

# File Storage
STATIC_DIR=static/images
MAX_IMAGE_SIZE=1024
