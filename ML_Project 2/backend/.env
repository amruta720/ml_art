# Ollama Configuration (Free Local LLM - No API Key Required!)
# Ollama runs locally on your machine - completely free!
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434

# Model Configuration
STABLE_DIFFUSION_MODEL=runwayml/stable-diffusion-v1-5

# Server Configuration
HOST=0.0.0.0
PORT=8000

# File Storage
STATIC_DIR=static/images
MAX_IMAGE_SIZE=1024

# Image Generation Backend Selection
# Options: "local_diffusion", "stability_ai", or "gemini_imagen"
IMAGE_BACKEND=stability_ai

# Stability AI API Key (get from https://platform.stability.ai/account/keys)
STABILITY_API_KEY=sk-MggCUBJNsSkATiNKbP4Igz7akg7xsFjOMSZOpAsiX8198MRM

